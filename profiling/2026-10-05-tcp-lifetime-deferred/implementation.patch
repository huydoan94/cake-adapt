+	side = outgoing_packet ? TCPDELAY_SIDE_LOCAL : TCPDELAY_SIDE_REMOTE;
+	generation = packet_generation(&flow, sequence, acknowledgment, tcp.syn, tcp.ack, side);
+	if (generation == 0U)
+		return 0;
+	if (outgoing_packet)
+		outgoing(&flow, generation, tsval);
+	else
+		incoming(&flow, generation, tsval, tsecr);
 	return 0;
 }
 
