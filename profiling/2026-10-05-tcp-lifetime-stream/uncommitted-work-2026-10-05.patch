+static void run_simultaneous_open(
+	int sender,
+	unsigned int capture_index,
+	unsigned int peer_index,
+	struct tcpdelay_capture *capture,
+	struct tcpdelay_record_flow flow
+)
+{
+	struct packet_spec packet = {
+		.port = 51003U,
+		.sequence = 0x10203040U,
+		.flags = TCPDELAY_TCP_SYN,
+		.outgoing = true,
+	};
+	struct tcpdelay_lifetime_slot *slot;
+	bool local_syn_drained;
+	bool remote_syn_drained;
+	bool local_synack_drained;
+	bool remote_synack_drained;
+
+	flow.local_port = htons(packet.port);
+	packet.timestamp = true;
+	send_packet(sender, capture_index, &packet);
+	local_syn_drained = drain_until(capture, 1U);
+	packet.sequence = 0x50607080U;
+	packet.outgoing = false;
+	send_packet(sender, peer_index, &packet);
+	remote_syn_drained = drain_until(capture, 1U);
+	packet.flags = TCPDELAY_TCP_SYN | TCPDELAY_TCP_ACK;
+	packet.sequence = 0x10203040U;
+	packet.acknowledgment = 0x50607081U;
+	packet.outgoing = true;
+	send_packet(sender, capture_index, &packet);
+	local_synack_drained = drain_until(capture, 1U);
+	packet.sequence = 0x50607080U;
+	packet.acknowledgment = 0x10203041U;
+	packet.outgoing = false;
+	send_packet(sender, peer_index, &packet);
+	remote_synack_drained = drain_until(capture, 1U);
+	slot = find_flow(capture, &flow);
+	check(local_syn_drained && remote_syn_drained && local_synack_drained &&
+		      remote_synack_drained && slot != NULL && slot->active && slot->confirmed &&
+		      slot->local_isn == 0x10203040U && slot->remote_isn == 0x50607080U,
+	      "simultaneous_open_pairs_both_syn_directions");
+	if (slot == NULL || !slot->confirmed)
+		fprintf(stderr,
+			"simultaneous-open state missing after four drained lifecycle records\n");
+}
+
+static void run_ring_loss_recovery(
+	int sender,
+	unsigned int capture_index,
+	struct tcpdelay_capture *capture,
+	struct tcpdelay_record_flow flow
+)
+{
+	/* Ring capacity is 256 KiB; each record consumes 64 bytes plus ring metadata. */
+	enum {
+		LIFECYCLE_BURST = TCPDELAY_RING_BYTES / sizeof(struct tcpdelay_record) + 256U
+	};
+	struct tcpdelay_counters counters;
+	struct packet_spec packet = {
+		.port = 51004U,
+		.sequence = 0xabcdef01U,
+		.flags = TCPDELAY_TCP_SYN,
+		.outgoing = true,
+	};
+	uint32_t epoch = capture->epoch;
+	uint32_t loss_marker = 0U;
+	uint64_t original_generation = capture->lifetime->next_generation;
+	struct timespec cooldown = { .tv_sec = 1, .tv_nsec = 100000000L };
+	unsigned int index;
+	bool marker_readable;
+	bool counters_readable;
+	bool recovered;
+	bool handshake_drained;
+	struct tcpdelay_lifetime_slot *slot;
+
+	flow.local_port = htons(packet.port);
+	flow.remote_port = htons(443U);
+	for (index = 0U; index < LIFECYCLE_BURST; index++)
+		send_packet(sender, capture_index, &packet);
+	marker_readable = bpf_map_lookup_elem(capture->loss_descriptor, &epoch, &loss_marker) == 0;
+	counters_readable = tcpdelay_capture_counters(capture, &counters) == 0;
+	check(marker_readable && loss_marker == 1U && counters_readable && counters.ring_full > 0U,
+	      "ring_loss_publishes_epoch_marker_and_counters_remain_readable");
+	(void)drain_until(capture, 1U);
+	check(capture->state == TCPDELAY_CAPTURE_RECOVERING &&
+		      !tcpdelay_capture_timing_available(capture) &&
+		      capture->lifetime->next_generation == 0U,
+	      "loss_consumer_withdraws_timing_and_resets_lifetime");
+	(void)nanosleep(&cooldown, NULL);
+	(void)tcpdelay_capture_drain(capture);
+	recovered = capture->state == TCPDELAY_CAPTURE_READY && capture->epoch == epoch + 1U &&
+		    tcpdelay_capture_timing_available(capture) &&
+		    capture->lifetime->next_generation == 0U;
+	check(recovered, "loss_cooldown_advances_epoch_without_old_record_repopulation");
+	packet.sequence++;
+	send_packet(sender, capture_index, &packet);
+	handshake_drained = drain_until(capture, 1U);
+	packet.flags = TCPDELAY_TCP_SYN | TCPDELAY_TCP_ACK;
+	packet.sequence = 0x13572468U;
+	packet.acknowledgment = 0xabcdef02U;
+	packet.outgoing = false;
+	send_packet(sender, capture_index, &packet);
+	{
+		bool synack_drained = drain_until(capture, 1U);
+
+		packet.flags = TCPDELAY_TCP_ACK;
+		packet.sequence = 0xabcdef02U;
+		packet.acknowledgment = 0x13572469U;
+		packet.timestamp = true;
+		packet.tsval = 7U;
+		packet.outgoing = true;
+		send_packet(sender, capture_index, &packet);
+		{
+			bool ack_drained = drain_until(capture, 1U);
+
+			slot = find_flow(capture, &flow);
+			check(handshake_drained && synack_drained && ack_drained && slot != NULL &&
+				      slot->confirmed && slot->generation != original_generation,
+			      "fresh_post_recovery_handshake_confirms_new_generation");
+		}
+	}
+}
