
config cake_adapt 'main'
	option enabled '1'
	option interface 'eth1'
	option adjust_dl_shaper_rate '1'
	option min_dl_shaper_rate_kbps '10000'
	option base_dl_shaper_rate_kbps '20000'
	option max_dl_shaper_rate_kbps '50000'
	option adjust_ul_shaper_rate '1'
	option min_ul_shaper_rate_kbps '10000'
	option base_ul_shaper_rate_kbps '20000'
	option max_ul_shaper_rate_kbps '50000'
	option output_processing_stats '1'
	option output_load_stats '1'
	option output_reflector_stats '1'
	option output_summary_stats '1'
	option output_cake_changes '1'
	option output_cpu_stats '0'
	option output_cpu_raw_stats '0'
	option debug '1'
	option log_DEBUG_messages_to_syslog '0'
	option log_to_file '1'
	list reflectors '1.1.1.1'
