digraph G {
  graph [rankdir=TB,bgcolor="white",pad="0.30",nodesep="0.35",ranksep="0.48",splines=polyline,fontname="Arial",label="09 — Rate factors, thresholds, rounding, and bounds",labelloc=t,fontsize=22,fontcolor="#0f172a"];
  node [fontname="Arial",fontsize=11,margin="0.14,0.09",penwidth=1.2];
  edge [fontname="Arial",fontsize=9,color="#475569",fontcolor="#334155",arrowsize=0.7,penwidth=1.1];
  comp [label="compensation_µs = max_wire_packet_bits\n÷ shaper rate, rounded to the µs",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  thr [label="adjust_up = 10 ms + c\ndelay_thr = 30 ms + c\nadjust_down = 60 ms + c",shape=note,style="filled",fillcolor="#f4f4f5",color="#71717a"];
  down [label="downward adjustment a ∈ [0, 1]\na = (avg − delay_thr) / (adjust_down − delay_thr)\nas a ratio per million",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  dfac [label="factor = 0.99 − a·(0.99 − 0.75)",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  up [label="upward adjustment a ∈ [0, 1]\na = (delay_thr − avg) / (delay_thr − adjust_up)\nas a ratio per million",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  ufac [label="factor = 1.00 + a·(1.04 − 1.00)",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  scale [label="scale_rate: rate × factor / 1 000 000\n(overflow-safe), truncated to whole bytes/s",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  decay [label="rate_toward_base\n> base: ×0.990, floor at base\n< base: ×1.010, cap at base",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  clamp [label="clamp [minimum, maximum]",shape=box,style="rounded,filled,bold",fillcolor="#dcfce7",color="#15803d"];
  comp -> thr;
  thr -> down [label="congestion"];
  thr -> up [label="high load"];
  down -> dfac;
  up -> ufac;
  dfac -> scale;
  ufac -> scale;
  scale -> clamp;
  decay -> clamp [label="low load"];
}
