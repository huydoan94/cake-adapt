digraph G {
  graph [rankdir=TB,bgcolor="white",pad="0.30",nodesep="0.35",ranksep="0.48",splines=polyline,fontname="Arial",label="08 — Exact per-direction rate decision order",labelloc=t,fontsize=22,fontcolor="#0f172a"];
  node [fontname="Arial",fontsize=11,margin="0.14,0.09",penwidth=1.2];
  edge [fontname="Arial",fontsize=9,color="#475569",fontcolor="#334155",arrowsize=0.7,penwidth=1.1];
  begin [label="For download, then upload",shape=oval,style="filled",fillcolor="#d9f7f1",color="#17806d"];
  enabled [label="adjust_*_shaper_rate enabled?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  observe [label="Observation only; output not actionable",shape=box,style="rounded,filled,bold",fillcolor="#dcfce7",color="#15803d"];
  initial [label="initial_pending and input valid?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  base [label="Set desired=base\nreason=INITIAL; initialize clocks",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  valid [label="Direction sample and latency valid?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  holdbad [label="Hold current desired rate",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  cong [label="Congestion detected AND\nnow − last_congestion > 300 ms?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  cut [label="Apply congestion factor\nupdate congestion + decay clocks",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  clearhigh [label="Congestion clear AND high load?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  fresh [label="traffic_sample_id differs from consumed ID AND\ncongestion refractory period elapsed?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  grow [label="Consume sample ID\napply upward factor\nupdate decay clock",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  decay [label="Congestion clear, low load, rate != base AND\nnow − last_decay > 1 s?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  toward [label="Scale by 0.99 above base or 1.01 below base\ncap at base; update decay clock",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  same [label="Keep current desired rate",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  clamp [label="Clamp desired to [minimum, maximum]",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  changed [label="Desired differs from cached kernel CAKE rate?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  action [label="Output actionable rate change\n(or RECONCILE if policy itself held)",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  none [label="No kernel update for this direction",shape=box,style="rounded,filled,bold",fillcolor="#dcfce7",color="#15803d"];
  begin -> enabled;
  enabled -> observe [label="no"];
  enabled -> initial [label="yes"];
  initial -> base [label="yes"];
  initial -> valid [label="no"];
  valid -> holdbad [label="no"];
  valid -> cong [label="yes"];
  cong -> cut [label="yes"];
  cong -> clearhigh [label="no"];
  clearhigh -> fresh [label="yes"];
  clearhigh -> decay [label="no"];
  fresh -> grow [label="yes"];
  fresh -> same [label="no"];
  decay -> toward [label="yes"];
  decay -> same [label="no"];
  base -> clamp;
  holdbad -> clamp;
  cut -> clamp;
  grow -> clamp;
  toward -> clamp;
  same -> clamp;
  clamp -> changed;
  changed -> action [label="yes"];
  changed -> none [label="no"];
}
