digraph G {
  graph [rankdir=TB,bgcolor="white",pad="0.30",nodesep="0.35",ranksep="0.48",splines=polyline,fontname="Arial",label="02 — Monitor initialization and uloop event topology",labelloc=t,fontsize=22,fontcolor="#0f172a"];
  node [fontname="Arial",fontsize=11,margin="0.14,0.09",penwidth=1.2];
  edge [fontname="Arial",fontsize=9,color="#475569",fontcolor="#334155",arrowsize=0.7,penwidth=1.1];
  start [label="monitor_run(config)",shape=oval,style="filled",fillcolor="#d9f7f1",color="#17806d"];
  pingers [label="pingers_prepare\nbind pinger slots and timers",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  controller [label="control_start\ncontroller_init",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  reflectors [label="reflectors_start\ntrackers, optional shuffle, health windows",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  clocks [label="seed reflector, response and\npinger clocks; state = RUNNING",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  uloop [label="uloop_init",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  events [label="links_watch_events\nsubscribe RTNLGRP_TC",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  timers [label="traffic timer\nreflector health timer",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  first [label="links_observe\napply_traffic_cadence",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  optional [label="watch_cpu (if CPU stats)\nwatch_log_maintenance (if log file)",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  latency [label="pingers_watch\n(starts pingers once CAKE is ready)",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  run [label="uloop_run()",shape=box,style="rounded,filled,bold",fillcolor="#dcfce7",color="#15803d"];
  fail [label="required setup failed\n→ cleanup, result -1",shape=box,style="rounded,filled",fillcolor="#ffe3e0",color="#c2413b"];
  cb [label="callbacks:\nhandle_traffic_timer · handle_health_timer\nhandle_qdisc_events · handle_pinger_output/exit\nhandle_cpu_timer · handle_log_timer · SIGUSR1/2",shape=note,style="filled",fillcolor="#f4f4f5",color="#71717a"];
  start -> pingers;
  pingers -> controller;
  controller -> reflectors;
  reflectors -> clocks;
  clocks -> uloop;
  uloop -> events;
  events -> timers;
  timers -> first;
  first -> optional;
  optional -> latency;
  latency -> run;
  controller -> fail [label="error",style=dashed,color="#64748b"];
  events -> fail [label="error",style=dashed,color="#64748b"];
  timers -> fail [label="error",style=dashed,color="#64748b"];
  run -> cb [style=dashed,color="#64748b"];
}
