digraph G {
  graph [rankdir=TB,bgcolor="white",pad="0.30",nodesep="0.35",ranksep="0.48",splines=polyline,fontname="Arial",label="03 — CAKE readiness, traffic counters, and fresh-sample IDs",labelloc=t,fontsize=22,fontcolor="#0f172a"];
  node [fontname="Arial",fontsize=11,margin="0.14,0.09",penwidth=1.2];
  edge [fontname="Arial",fontsize=9,color="#475569",fontcolor="#334155",arrowsize=0.7,penwidth=1.1];
  tick [label="Traffic timer / immediate lifecycle refresh",shape=oval,style="filled",fillcolor="#d9f7f1",color="#17806d"];
  due [label="Observation due?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  cached [label="Keep state; mark this sample invalid",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  dump [label="cake_read(interface): RTM_GETQDISC dump",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  found [label="CAKE found?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  avail [label="Cache handle, parent, bytes, bandwidth\nstate=AVAILABLE; next observation now",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  notfound [label="state=NOT_FOUND\nnext retry=never; await qdisc event",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  failed [label="state=FAILED\nretry after configured/default delay",shape=box,style="rounded,filled",fillcolor="#ffe3e0",color="#c2413b"];
  ready [label="Both directions AVAILABLE?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  close [label="Stop fping; skip activity/control",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  sample [label="traffic_update(current counter, time, identity)",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  baseline [label="Previous valid baseline and same qdisc identity?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  delta [label="counter increased and elapsed > 0?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  invalid [label="Advance baseline; output invalid sample",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  rate [label="rate bit/s = Δbytes × 8 × 1e6 / Δtime_us\nmark valid; increment sample ID",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  activity [label="Update RUNNING/IDLE/STALL; ensure fping",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  log [label="Optional LOAD record when both samples valid",shape=box,style="rounded,filled,bold",fillcolor="#dcfce7",color="#15803d"];
  tick -> due;
  due -> cached [label="no"];
  due -> dump [label="yes"];
  dump -> found;
  found -> avail [label="yes"];
  found -> notfound [label="no, clean absence"];
  found -> failed [label="transport/decode error"];
  cached -> ready;
  avail -> ready;
  notfound -> ready;
  failed -> ready;
  ready -> close [label="no"];
  ready -> sample [label="yes"];
  sample -> baseline;
  baseline -> invalid [label="no"];
  baseline -> delta [label="yes"];
  delta -> invalid [label="no"];
  delta -> rate [label="yes"];
  invalid -> activity;
  rate -> activity;
  activity -> log;
}
