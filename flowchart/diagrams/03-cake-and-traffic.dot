digraph G {
  graph [rankdir=TB,bgcolor="white",pad="0.30",nodesep="0.35",ranksep="0.48",splines=polyline,fontname="Arial",label="03 — CAKE readiness, traffic counters, and fresh-sample IDs",labelloc=t,fontsize=22,fontcolor="#0f172a"];
  node [fontname="Arial",fontsize=11,margin="0.14,0.09",penwidth=1.2];
  edge [fontname="Arial",fontsize=9,color="#475569",fontcolor="#334155",arrowsize=0.7,penwidth=1.1];
  tick [label="traffic timer tick",shape=oval,style="filled",fillcolor="#d9f7f1",color="#17806d"];
  clock [label="CLOCK_MONOTONIC ok?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  clockfail [label="invalidate both directions;\nreport degraded once",shape=box,style="rounded,filled",fillcolor="#ffe3e0",color="#c2413b"];
  due [label="directions due for observation\n(not parked as NOT_FOUND)",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  dump [label="cake_read_all\none RTM_GETQDISC dump\nmatch root CAKE by cached ifindex",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  result [label="read result",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  found [label="FOUND: state AVAILABLE\nlog discovered / recovered once\nMTU only if new handle or index",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  notfound [label="NOT_FOUND: log once;\npark until RTM_NEWQDISC",shape=box,style="rounded,filled",fillcolor="#ffe3e0",color="#c2413b"];
  error [label="ERROR: log once;\nretry after interface_up_check_interval",shape=box,style="rounded,filled",fillcolor="#ffe3e0",color="#c2413b"];
  comp [label="control_update_compensation\n(first time: compensated cadence)",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  traffic [label="traffic_update per direction",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  tresult [label="update result",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  rate [label="rate = Δbytes·8000/Δms\ntraffic_valid; sample_id++",shape=box,style="rounded,filled,bold",fillcolor="#dcfce7",color="#15803d"];
  rebase [label="baseline / counter reset /\nqdisc replaced / invalid interval\n→ no rate this tick",shape=note,style="filled",fillcolor="#f4f4f5",color="#71717a"];
  load [label="LOAD record\n(when both directions valid)",shape=parallelogram,style="filled",fillcolor="#e9f7ff",color="#24749c"];
  ready [label="both CAKE AVAILABLE?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  suspend [label="pingers_close;\npingers_suspended",shape=box,style="rounded,filled",fillcolor="#ffe3e0",color="#c2413b"];
  activity [label="update_activity\n(chart 11), pingers_watch",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  tick -> clock;
  clock -> clockfail [label="no"];
  clock -> due [label="yes"];
  due -> dump;
  dump -> result;
  result -> found [label="found"];
  result -> notfound [label="missing"];
  result -> error [label="error"];
  found -> comp;
  notfound -> comp [style=dashed,color="#64748b"];
  error -> comp [style=dashed,color="#64748b"];
  comp -> traffic;
  traffic -> tresult;
  tresult -> rate [label="RATES"];
  tresult -> rebase [label="other"];
  rate -> load;
  load -> ready;
  rebase -> ready;
  ready -> suspend [label="no"];
  ready -> activity [label="yes"];
}
