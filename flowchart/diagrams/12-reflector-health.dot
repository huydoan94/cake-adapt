digraph G {
  graph [rankdir=TB,bgcolor="white",pad="0.30",nodesep="0.35",ranksep="0.48",splines=polyline,fontname="Arial",label="12 — Reflector health, comparison, and replacement",labelloc=t,fontsize=22,fontcolor="#0f172a"];
  node [fontname="Arial",fontsize=11,margin="0.14,0.09",penwidth=1.2];
  edge [fontname="Arial",fontsize=9,color="#475569",fontcolor="#334155",arrowsize=0.7,penwidth=1.1];
  tick [label="reflector health timer",shape=oval,style="filled",fillcolor="#d9f7f1",color="#17806d"];
  gate [label="CAKE ready ∧ RUNNING ∧\nclock ok ∧ grace over?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  skip [label="return",shape=note,style="filled",fillcolor="#f4f4f5",color="#71717a"];
  replace [label="replacement interval elapsed?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  random [label="pick a random active pinger\n(getentropy)",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  compare [label="comparison interval elapsed?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  cmp [label="reflector_compare:\nminimum baseline sum and delta EWMAs\nREFLECTOR records",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  outlier [label="first reflector over a threshold?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  check [label="health_check each pinger:\noffence if no response in deadline",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  bad [label="offences ≥ threshold in window?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  once [label="first replacement this cycle?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  skiprep [label="debug: skipping replacement",shape=note,style="filled",fillcolor="#f4f4f5",color="#71717a"];
  spare [label="spare reflector available?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  retain [label="keep reflector;\nreset its offences",shape=note,style="filled",fillcolor="#f4f4f5",color="#71717a"];
  rotate [label="reflector_rotate; drop tracker\nunless retain_reflector_stats;\nreset offences; restart pingers",shape=box,style="rounded,filled,bold",fillcolor="#dcfce7",color="#15803d"];
  tick -> gate;
  gate -> skip [label="no"];
  gate -> replace [label="yes"];
  replace -> random [label="yes"];
  random -> spare;
  replace -> compare [label="no"];
  compare -> cmp [label="yes"];
  cmp -> outlier;
  outlier -> spare [label="yes"];
  outlier -> check [label="no"];
  compare -> check [label="no"];
  check -> bad;
  bad -> once [label="yes"];
  once -> spare [label="yes"];
  once -> skiprep [label="no"];
  spare -> retain [label="no"];
  spare -> rotate [label="yes"];
}
