digraph G {
  graph [rankdir=TB,bgcolor="white",pad="0.30",nodesep="0.35",ranksep="0.48",splines=polyline,fontname="Arial",label="12 — Reflector health, comparison, and replacement",labelloc=t,fontsize=22,fontcolor="#0f172a"];
  node [fontname="Arial",fontsize=11,margin="0.14,0.09",penwidth=1.2];
  edge [fontname="Arial",fontsize=9,color="#475569",fontcolor="#334155",arrowsize=0.7,penwidth=1.1];
  tick [label="1 s reflector health timer",shape=oval,style="filled",fillcolor="#d9f7f1",color="#17806d"];
  eligible [label="RUNNING + CAKE ready + grace expired?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  return [label="Return; rearm timer",shape=box,style="rounded,filled,bold",fillcolor="#dcfce7",color="#15803d"];
  random [label="Randomization interval due?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  choose [label="Choose random active slot and spare reflector",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  compare [label="Comparison interval due?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  best [label="Find best active baseline and delta EWMA",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  poor [label="Any active exceeds configured excess threshold?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  health [label="For each active slot: response age >1 s?\nrecord offense in 60-check ring",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  bad [label="Any slot has >=3 offenses?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  spare [label="Unused configured reflector available?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  warn [label="Warn; retain active reflector; reset health history",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  swap [label="Promote first spare into active slot\nmove old reflector to spare tail",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  retain [label="retain_reflector_stats?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  reset [label="Reset old tracker statistics",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  child [label="Reset slot health; stop shared fping child\nrestart with new active target set",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  done [label="Finish this health tick",shape=box,style="rounded,filled,bold",fillcolor="#dcfce7",color="#15803d"];
  tick -> eligible;
  eligible -> return [label="no"];
  eligible -> random [label="yes"];
  random -> choose [label="yes"];
  random -> compare [label="no"];
  choose -> spare;
  compare -> best [label="yes"];
  compare -> health [label="no"];
  best -> poor;
  poor -> spare [label="yes"];
  poor -> health [label="no"];
  health -> bad;
  bad -> return [label="no"];
  bad -> spare [label="yes"];
  spare -> warn [label="no"];
  spare -> swap [label="yes"];
  warn -> done;
  swap -> retain;
  retain -> reset [label="no"];
  retain -> child [label="yes"];
  reset -> child;
  child -> done;
}
