digraph G {
  graph [rankdir=TB,bgcolor="white",pad="0.30",nodesep="0.35",ranksep="0.48",splines=polyline,fontname="Arial",label="01 — Service, CLI, configuration, and startup",labelloc=t,fontsize=22,fontcolor="#0f172a"];
  node [fontname="Arial",fontsize=11,margin="0.14,0.09",penwidth=1.2];
  edge [fontname="Arial",fontsize=9,color="#475569",fontcolor="#334155",arrowsize=0.7,penwidth=1.1];
  start [label="service start / reload",shape=oval,style="filled",fillcolor="#d9f7f1",color="#17806d"];
  load [label="config_load 'cake-adapt'",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  runtime [label="prepare /var/run/cake-adapt\n(0700, not a symlink)",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  each [label="for each config cake_adapt section",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  enabled [label="enabled = 1?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  skip [label="syslog notice: disabled;\nnot started",shape=note,style="filled",fillcolor="#f4f4f5",color="#71717a"];
  stage [label="stage a copy of /etc/config/cake-adapt",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  import [label="config_file set?\nrun importer in a child Bash",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  validate [label="cake-adapt -C stage -S section -V",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  valid [label="valid?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  reject [label="syslog error;\ninstance not started",shape=box,style="rounded,filled",fillcolor="#ffe3e0",color="#c2413b"];
  procd [label="procd instance\nrespawn, term_timeout 5,\nreload on config file change",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  cli [label="main(): getopt -C -S -f -V -L",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  config [label="defaults_apply → uci_load → section\n→ typed options → resolve_interfaces\n→ config_validate",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  configok [label="configuration valid?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  fail [label="log error; exit 1",shape=box,style="rounded,filled",fillcolor="#ffe3e0",color="#c2413b"];
  denabled [label="enabled?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  disabled [label="syslog: disabled by configuration;\nexit 0",shape=box,style="rounded,filled,bold",fillcolor="#dcfce7",color="#15803d"];
  logs [label="open log file\ncake-adapt[.<section>].log,\nprint record headers",shape=parallelogram,style="filled",fillcolor="#e9f7ff",color="#24749c"];
  mode [label="syslog: Starting cake-adapt …\ncontrol or observation-only",shape=parallelogram,style="filled",fillcolor="#e9f7ff",color="#24749c"];
  run [label="monitor_run()",shape=box,style="rounded,filled,bold",fillcolor="#dcfce7",color="#15803d"];
  start -> load;
  load -> runtime;
  runtime -> each;
  each -> enabled;
  enabled -> skip [label="no"];
  enabled -> stage [label="yes"];
  stage -> import;
  import -> validate;
  validate -> valid;
  valid -> reject [label="no"];
  valid -> procd [label="yes"];
  procd -> cli [label="exec"];
  cli -> config;
  config -> configok;
  configok -> fail [label="no"];
  configok -> denabled [label="yes"];
  denabled -> disabled [label="no"];
  denabled -> logs [label="yes"];
  logs -> mode;
  mode -> run;
}
