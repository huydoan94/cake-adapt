digraph G {
  graph [rankdir=TB,bgcolor="white",pad="0.30",nodesep="0.35",ranksep="0.48",splines=polyline,fontname="Arial",label="11 — RUNNING, IDLE, STALL, and recovery state machine",labelloc=t,fontsize=22,fontcolor="#0f172a"];
  node [fontname="Arial",fontsize=11,margin="0.14,0.09",penwidth=1.2];
  edge [fontname="Arial",fontsize=9,color="#475569",fontcolor="#334155",arrowsize=0.7,penwidth=1.1];
  sample [label="Traffic callback with both CAKE qdiscs available",shape=oval,style="filled",fillcolor="#d9f7f1",color="#17806d"];
  state [label="Current activity state?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  idlewake [label="IDLE: either valid rate > 2 Mbit/s?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  stayidle [label="Remain IDLE; fping stays closed",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  wake [label="Set RUNNING; response clock=now\nhealth grace=2 ping periods; reset health",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  grace [label="RUNNING but still in wake grace?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  age [label="Age since last successful latency reply",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  stale [label="age > stall timeout?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  loads [label="Both rates > 10 kbit/s?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  stall [label="Enter/keep STALL",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  running [label="Set/keep RUNNING",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  healthy [label="Enough healthy replies and sleep enabled?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  quiet [label="Both rates <= 2 Mbit/s continuously for 60 s?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  enteridle [label="Enter IDLE; stop fping\noptionally enforce minimum rates",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  global [label="No successful response for >=10 s?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  degrade [label="Warn once; enforce minima if enabled\nrestart fping if last start >=10 s",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  ensure [label="Ensure fping open unless IDLE",shape=box,style="rounded,filled,bold",fillcolor="#dcfce7",color="#15803d"];
  sample -> state;
  state -> idlewake [label="IDLE"];
  state -> grace [label="RUNNING"];
  state -> age [label="STALL"];
  idlewake -> stayidle [label="no"];
  idlewake -> wake [label="yes"];
  wake -> grace;
  grace -> running [label="yes"];
  grace -> age [label="no"];
  age -> stale;
  stale -> running [label="no"];
  stale -> loads [label="yes"];
  loads -> running [label="yes"];
  loads -> stall [label="no"];
  running -> healthy;
  stall -> global;
  healthy -> quiet [label="yes"];
  healthy -> global [label="no"];
  quiet -> enteridle [label="yes"];
  quiet -> global [label="no"];
  enteridle -> ensure;
  global -> degrade [label="yes"];
  global -> ensure [label="no"];
  degrade -> ensure;
  stayidle -> ensure;
}
