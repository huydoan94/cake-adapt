digraph G {
  graph [rankdir=TB,bgcolor="white",pad="0.30",nodesep="0.35",ranksep="0.48",splines=polyline,fontname="Arial",label="11 — RUNNING, IDLE, STALL, and recovery state machine",labelloc=t,fontsize=22,fontcolor="#0f172a"];
  node [fontname="Arial",fontsize=11,margin="0.14,0.09",penwidth=1.2];
  edge [fontname="Arial",fontsize=9,color="#475569",fontcolor="#334155",arrowsize=0.7,penwidth=1.1];
  running [label="RUNNING",shape=oval,style="filled",fillcolor="#d9f7f1",color="#17806d"];
  grace [label="within pinger setup grace?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  stallq [label="response age > stall timeout?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  loads [label="debug: Checking loads;\nboth rates > stall_thr?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  stall [label="STALL",shape=box,style="rounded,filled",fillcolor="#ffe3e0",color="#c2413b"];
  idleq [label="sleep enabled ∧ valid ∧\nboth ≤ active_thr?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  timer [label="idle for > sustained_idle_sleep_thr?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  idle [label="IDLE\noptional minimum rates;\nclose_latency",shape=note,style="filled",fillcolor="#f4f4f5",color="#71717a"];
  wake [label="either rate > active_thr?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  resume [label="RUNNING after IDLE:\ngrant pinger grace; watch_latency",shape=box,style="rounded,filled,bold",fillcolor="#dcfce7",color="#15803d"];
  recover [label="response age ≤ stall timeout\n∨ both rates > stall_thr?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  global [label="response age ≥ global timeout?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  warn [label="warning once; optional minimum\nrates; restart pingers once\nper timeout period",shape=box,style="rounded,filled",fillcolor="#ffe3e0",color="#c2413b"];
  stallend [label="RUNNING\n(debug: connection stall ended)",shape=box,style="rounded,filled,bold",fillcolor="#dcfce7",color="#15803d"];
  running -> grace;
  grace -> running [label="yes",style=dashed,color="#64748b"];
  grace -> stallq [label="no"];
  stallq -> loads [label="yes"];
  loads -> stall [label="no"];
  loads -> global [label="yes"];
  stallq -> idleq [label="no"];
  idleq -> timer [label="yes"];
  idleq -> running [label="no (reset idle clock)",style=dashed,color="#64748b"];
  timer -> idle [label="yes"];
  idle -> wake [label="each tick"];
  wake -> resume [label="yes"];
  stall -> recover [label="each tick"];
  recover -> stallend [label="yes"];
  stall -> global;
  global -> warn [label="yes"];
}
