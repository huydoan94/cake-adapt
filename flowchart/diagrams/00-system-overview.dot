digraph G {
  graph [rankdir=TB,bgcolor="white",pad="0.30",nodesep="0.35",ranksep="0.48",splines=polyline,fontname="Arial",label="00 — System and ownership overview",labelloc=t,fontsize=22,fontcolor="#0f172a"];
  node [fontname="Arial",fontsize=11,margin="0.14,0.09",penwidth=1.2];
  edge [fontname="Arial",fontsize=9,color="#475569",fontcolor="#334155",arrowsize=0.7,penwidth=1.1];
  procd [label="procd\n/etc/init.d/cake-adapt",shape=cylinder,style="filled",fillcolor="#eee8ff",color="#7253a6"];
  uci [label="/etc/config/cake-adapt (UCI)\n+ optional cake-autorate config_file import",shape=parallelogram,style="filled",fillcolor="#e9f7ff",color="#24749c"];
  main [label="main.c\nCLI, config_load, logging setup",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  loop [label="monitor/\nuloop timers, fds, child processes, signals",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  pinger [label="fping (or irtt) children",shape=cylinder,style="filled",fillcolor="#eee8ff",color="#7253a6"];
  latency [label="latency/\nparse replies, per-reflector OWD baseline and delta",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  observe [label="cake/ + platform/traffic\none qdisc dump per tick → achieved rates",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  controller [label="controller/\ndelay window, congestion, rate decision,\nactivity state, reflector health",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  apply [label="cake_set_bandwidth\n+ readback verification",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  kernel [label="Kernel CAKE qdiscs\nroot of <ul_if> and ifb4<if>\n(created by SQM)",shape=cylinder,style="filled",fillcolor="#eee8ff",color="#7253a6"];
  log [label="logging/log.c\nsyslog + cake-autorate-compatible records",shape=parallelogram,style="filled",fillcolor="#e9f7ff",color="#24749c"];
  procd -> main [label="one instance per enabled section\n-C runtime dir -S section"];
  uci -> main [label="validated with -V before spawn",style=dashed,color="#64748b"];
  main -> loop [label="monitor_run()"];
  pinger -> latency [label="stdout lines (ustream)"];
  latency -> loop [label="OWD deltas"];
  kernel -> observe [label="RTM_GETQDISC dump"];
  observe -> loop [label="achieved rates, CAKE bandwidth"];
  kernel -> loop [label="RTM_NEWQDISC / RTM_DELQDISC",style=dashed,color="#64748b"];
  loop -> controller [label="controller_input"];
  controller -> apply [label="rate_changed"];
  apply -> kernel [label="TCA_CAKE_BASE_RATE64"];
  loop -> log [style=dashed,color="#64748b"];
}
