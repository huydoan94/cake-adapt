digraph G {
  graph [rankdir=TB,bgcolor="white",pad="0.30",nodesep="0.35",ranksep="0.48",splines=polyline,fontname="Arial",label="04 — Kernel qdisc lifecycle events",labelloc=t,fontsize=22,fontcolor="#0f172a"];
  node [fontname="Arial",fontsize=11,margin="0.14,0.09",penwidth=1.2];
  edge [fontname="Arial",fontsize=9,color="#475569",fontcolor="#334155",arrowsize=0.7,penwidth=1.1];
  fd [label="RTNLGRP_TC socket readable",shape=oval,style="filled",fillcolor="#d9f7f1",color="#17806d"];
  recv [label="netlink_receive_qdisc_events",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  recvok [label="receive ok?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  fatal [label="log error;\nresult -1; uloop_end",shape=box,style="rounded,filled",fillcolor="#ffe3e0",color="#c2413b"];
  parse [label="handle_qdisc_event\nparse tcmsg (reject truncated)",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  match [label="root qdisc on a\nmonitored interface?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  ignore [label="ignore",shape=note,style="filled",fillcolor="#f4f4f5",color="#71717a"];
  type [label="event type",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  delmatch [label="AVAILABLE and same handle?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  removed [label="log CAKE removed;\nclear observation; NOT_FOUND;\nreset traffic; close upload TCP capture;\nreset ACK sampling; pingers_close",shape=box,style="rounded,filled",fillcolor="#ffe3e0",color="#c2413b"];
  same [label="AVAILABLE with same handle?\n(bandwidth change)",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  refresh [label="invalidate; reset traffic;\ndue now; qdisc_refresh = true",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  cycle [label="after the batch:\nmonitor_tick() immediately",shape=box,style="rounded,filled,bold",fillcolor="#dcfce7",color="#15803d"];
  fd -> recv;
  recv -> recvok;
  recvok -> fatal [label="no"];
  recvok -> parse [label="per message"];
  parse -> match;
  match -> ignore [label="no"];
  match -> type [label="yes"];
  type -> delmatch [label="RTM_DELQDISC"];
  delmatch -> removed [label="yes"];
  delmatch -> ignore [label="no"];
  type -> same [label="RTM_NEWQDISC"];
  same -> ignore [label="yes"];
  same -> refresh [label="no"];
  refresh -> cycle;
}
