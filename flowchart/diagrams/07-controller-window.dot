digraph G {
  graph [rankdir=TB,bgcolor="white",pad="0.30",nodesep="0.35",ranksep="0.48",splines=polyline,fontname="Arial",label="07 — Delay window and congestion classification",labelloc=t,fontsize=22,fontcolor="#0f172a"];
  node [fontname="Arial",fontsize=11,margin="0.14,0.09",penwidth=1.2];
  edge [fontname="Arial",fontsize=9,color="#475569",fontcolor="#334155",arrowsize=0.7,penwidth=1.1];
  input [label="Direction input + valid latency",shape=oval,style="filled",fillcolor="#d9f7f1",color="#17806d"];
  delta [label="delta_us = current_owd − baseline_owd",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  push [label="Push delta into circular window of 6",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  stats [label="average_delta = sum(window)/6\ndelayed_count = count(delta > delay_threshold)",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  congestion [label="delayed_count >= 3?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  detected [label="Congestion detected for this direction",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  clear [label="Delay congestion clear",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  load [label="load% = achieved_rate / previous_desired_rate × 100",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  diag [label="Diagnostic thresholds",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  sat [label=">=90% for 3 observations → SATURATED",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  recover [label="<=80% for 3 observations → RECOVERED",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  unknown [label="Invalid load → UNKNOWN/reset run",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  rateclass [label="achieved_rate > high_load_thr × desired?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  high [label="Rate policy sees HIGH LOAD",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  low [label="Rate policy sees LOW LOAD",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  next [label="Proceed to exact rate decision",shape=box,style="rounded,filled,bold",fillcolor="#dcfce7",color="#15803d"];
  input -> delta;
  delta -> push;
  push -> stats;
  stats -> congestion;
  congestion -> detected [label="yes"];
  congestion -> clear [label="no"];
  stats -> load;
  load -> diag;
  diag -> sat [label=">=90%"];
  diag -> recover [label="<=80%"];
  diag -> unknown [label="invalid"];
  diag -> rateclass [label="between"];
  sat -> rateclass;
  recover -> rateclass;
  unknown -> rateclass;
  rateclass -> high [label="yes"];
  rateclass -> low [label="no"];
  detected -> next;
  clear -> next;
  high -> next;
  low -> next;
}
