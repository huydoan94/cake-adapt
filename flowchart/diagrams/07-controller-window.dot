digraph G {
  graph [rankdir=TB,bgcolor="white",pad="0.30",nodesep="0.35",ranksep="0.48",splines=polyline,fontname="Arial",label="07 — Delay window and congestion classification",labelloc=t,fontsize=22,fontcolor="#0f172a"];
  node [fontname="Arial",fontsize=11,margin="0.14,0.09",penwidth=1.2];
  edge [fontname="Arial",fontsize=9,color="#475569",fontcolor="#334155",arrowsize=0.7,penwidth=1.1];
  input [label="update_controller(latency observation)",shape=oval,style="filled",fillcolor="#d9f7f1",color="#17806d"];
  dir [label="direction_input:\nvalid = fresh rate ∧ CAKE valid ∧ bandwidth > 0\nsample_id, achieved rate, CAKE rate",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  line [label="update_line_state\n(logged only)",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  lat [label="latency valid?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  unknown [label="congestion UNKNOWN;\naverage 0",shape=note,style="filled",fillcolor="#f4f4f5",color="#71717a"];
  slot [label="replace oldest slot:\nsum −= old; sum += delta",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  delayed [label="delta > delay_threshold\n(+ compensation)?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  inc [label="mark slot delayed;\ndelayed_count++ (old mark removed)",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  clr [label="slot not delayed",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  avg [label="average = sum / window",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  thr [label="delayed_count ≥ detection_threshold?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  det [label="DETECTED",shape=box,style="rounded,filled",fillcolor="#ffe3e0",color="#c2413b"];
  clear [label="CLEAR",shape=box,style="rounded,filled,bold",fillcolor="#dcfce7",color="#15803d"];
  rate [label="adjust_rate (chart 08)",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  input -> dir;
  dir -> line;
  line -> lat;
  lat -> unknown [label="no"];
  lat -> slot [label="yes"];
  slot -> delayed;
  delayed -> inc [label="yes"];
  delayed -> clr [label="no"];
  inc -> avg;
  clr -> avg;
  avg -> thr;
  thr -> det [label="yes"];
  thr -> clear [label="no"];
  det -> rate;
  clear -> rate;
  unknown -> rate;
}
