digraph G {
  graph [rankdir=TB,bgcolor="white",pad="0.30",nodesep="0.35",ranksep="0.48",splines=polyline,fontname="Arial",label="15 — Worked example: 20 Mbit/s under load with a delay burst",labelloc=t,fontsize=22,fontcolor="#0f172a"];
  node [fontname="Arial",fontsize=11,margin="0.14,0.09",penwidth=1.2];
  edge [fontname="Arial",fontsize=9,color="#475569",fontcolor="#334155",arrowsize=0.7,penwidth=1.1];
  t0 [label="t = 0: first valid sample\nINITIAL → write 20 000 kbit/s",shape=oval,style="filled",fillcolor="#d9f7f1",color="#17806d"];
  hold [label="t = 50…300 ms: delta 5 ms, load 95%\nrefractory not elapsed → unchanged",shape=note,style="filled",fillcolor="#f4f4f5",color="#71717a"];
  inc1 [label="t = 350 ms: delta 45 ms enters window\navg 11.67 ms, 1 delayed → CLEAR\na = ⌊1000·(30.6 − 11.667)/20⌋ = 946\nfactor 1.03784 → 20 756 kbit/s",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  inc2 [label="t = 400 ms: avg 18.33 ms, 2 delayed → CLEAR\nthresholds now compensated at 20 756 kbit/s\n→ 21 264 kbit/s",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  cut [label="t = 450 ms: 3 delayed → DETECTED\navg 25.0 ms < 30.6 → minimum cut 0.99\n21 264 → 21 051 kbit/s",shape=box,style="rounded,filled",fillcolor="#ffe3e0",color="#c2413b"];
  wait [label="t = 500…750 ms: still DETECTED (avg up to 45 ms)\nbut < 300 ms since the cut → unchanged",shape=note,style="filled",fillcolor="#f4f4f5",color="#71717a"];
  clear [label="t = 800 ms: delta back to 5 ms\n2 delayed → CLEAR; refractory elapsed\n→ increase to 21 565 kbit/s",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  climb [label="t = 850…950 ms: 22 379 → 23 274 → 24 204\n(factor reaches 1.04 once avg ≤ 10.6 ms)",shape=box,style="rounded,filled,bold",fillcolor="#dcfce7",color="#15803d"];
  t0 -> hold;
  hold -> inc1;
  inc1 -> inc2;
  inc2 -> cut;
  cut -> wait;
  wait -> clear;
  clear -> climb;
}
