digraph G {
  graph [rankdir=TB,bgcolor="white",pad="0.30",nodesep="0.35",ranksep="0.48",splines=polyline,fontname="Arial",label="13 — Structured logging, CPU sampling, rotation, export, and reset",labelloc=t,fontsize=22,fontcolor="#0f172a"];
  node [fontname="Arial",fontsize=11,margin="0.14,0.09",penwidth=1.2];
  edge [fontname="Arial",fontsize=9,color="#475569",fontcolor="#334155",arrowsize=0.7,penwidth=1.1];
  msg [label="log_message(level, …)",shape=oval,style="filled",fillcolor="#d9f7f1",color="#17806d"];
  sys [label="syslog: errors and warnings,\ndebug only with log_debug_messages_to_syslog,\nstart/stop/disabled via log_system_message",shape=parallelogram,style="filled",fillcolor="#e9f7ff",color="#24749c"];
  rec [label="DATA / LOAD / REFLECTOR /\nSUMMARY / SHAPER / CPU records",shape=oval,style="filled",fillcolor="#d9f7f1",color="#17806d"];
  time [label="cached local datetime\n(reformatted once per second)",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  file [label="buffered write\nto log file or stdout (-f)",shape=parallelogram,style="filled",fillcolor="#e9f7ff",color="#24749c"];
  size [label="size > log_file_max_size_KB?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  tick [label="log timer: flush buffer;\nage > log_file_max_time_mins?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  rotate [label="rotate: copy to .old,\ntruncate in place (same inode)",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  usr1 [label="SIGUSR1",shape=oval,style="filled",fillcolor="#d9f7f1",color="#17806d"];
  export [label="export active + retained logs\n(optional compression)",shape=parallelogram,style="filled",fillcolor="#e9f7ff",color="#24749c"];
  usr2 [label="SIGUSR2",shape=oval,style="filled",fillcolor="#d9f7f1",color="#17806d"];
  reset [label="flush and truncate in place",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  cpu [label="CPU timer (RUNNING only)\n/proc/stat → CPU / CPU_RAW",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  msg -> sys;
  msg -> time [label="if log file"];
  rec -> time;
  time -> file;
  file -> size;
  size -> rotate [label="yes"];
  tick -> rotate [label="yes"];
  usr1 -> export;
  usr2 -> reset;
  cpu -> rec [style=dashed,color="#64748b"];
}
