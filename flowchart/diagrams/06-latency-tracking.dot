digraph G {
  graph [rankdir=TB,bgcolor="white",pad="0.30",nodesep="0.35",ranksep="0.48",splines=polyline,fontname="Arial",label="06 — Per-reflector baseline and delay tracking",labelloc=t,fontsize=22,fontcolor="#0f172a"];
  node [fontname="Arial",fontsize=11,margin="0.14,0.09",penwidth=1.2];
  edge [fontname="Arial",fontsize=9,color="#475569",fontcolor="#334155",arrowsize=0.7,penwidth=1.1];
  sample [label="parsed reply for target T",shape=oval,style="filled",fillcolor="#d9f7f1",color="#17806d"];
  active [label="T is an active reflector?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  unknown [label="degraded: unexpected reflector;\nrestart pingers",shape=box,style="rounded,filled",fillcolor="#ffe3e0",color="#c2413b"];
  clock [label="read realtime + monotonic",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  load [label="low_load = both directions\nload% < high_load_thr",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  rollover [label="timestamp rollover?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  reset [label="baseline = OWD;\ndelta = 0",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  alpha [label="OWD ≥ baseline ?\nα = 0.001 : α = 0.9",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  base [label="baseline += α·(OWD − baseline)\ndelta = OWD − baseline",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  ewma [label="low_load?\ndelta_ewma += 0.095·(delta − delta_ewma)",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  health [label="last response time → activity\nhealth_record_response",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  stale [label="reply > 500 ms old?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  skip [label="debug: Skipping",shape=note,style="filled",fillcolor="#f4f4f5",color="#71717a"];
  controller [label="update_controller\n(chart 07)",shape=box,style="rounded,filled,bold",fillcolor="#dcfce7",color="#15803d"];
  sample -> active;
  active -> unknown [label="no"];
  active -> clock [label="yes"];
  clock -> load;
  load -> rollover;
  rollover -> reset [label="yes"];
  rollover -> alpha [label="no"];
  alpha -> base;
  base -> ewma;
  reset -> health;
  ewma -> health;
  health -> stale;
  stale -> skip [label="yes"];
  stale -> controller [label="no"];
}
