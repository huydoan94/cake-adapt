digraph G {
  graph [rankdir=TB,bgcolor="white",pad="0.30",nodesep="0.35",ranksep="0.48",splines=polyline,fontname="Arial",label="05 — fping process ownership and reply parsing",labelloc=t,fontsize=22,fontcolor="#0f172a"];
  node [fontname="Arial",fontsize=11,margin="0.14,0.09",penwidth=1.2];
  edge [fontname="Arial",fontsize=9,color="#475569",fontcolor="#334155",arrowsize=0.7,penwidth=1.1];
  need [label="Both CAKE directions available, state not IDLE, retry due?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  keep [label="Existing owned child? keep it",shape=box,style="rounded,filled,bold",fillcolor="#dcfce7",color="#15803d"];
  argv [label="Build fping argv\n--timestamp --loop --period --interval --timeout\n-I <upload interface> + active reflectors",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  pipe [label="Create CLOEXEC nonblocking pipe",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  spawn [label="posix_spawnp fping in its own process group",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  watch [label="Register read fd in uloop",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  read [label="Pipe becomes readable",shape=oval,style="filled",fillcolor="#d9f7f1",color="#17806d"];
  line [label="Extract one complete bounded line",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  status [label="Line type?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  pending [label="EAGAIN / partial line: wait for more",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  timeout [label="Timeout/unreachable: no controller sample",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  parse [label="Parse timestamp, target, sequence, RTT",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  valid [label="Target is active and values valid?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  deliver [label="Update tracker + response clocks\ninvoke controller",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  bad [label="Log degraded state; close/reap child\nschedule retry",shape=box,style="rounded,filled",fillcolor="#ffe3e0",color="#c2413b"];
  stop [label="Close requested: SIGTERM process group\nwait 50×10 ms; SIGKILL if needed; reap",shape=box,style="rounded,filled,bold",fillcolor="#dcfce7",color="#15803d"];
  need -> keep [label="no or already open"];
  need -> argv [label="yes"];
  argv -> pipe;
  pipe -> spawn;
  spawn -> watch;
  watch -> read;
  read -> line;
  line -> status;
  status -> pending [label="partial/EAGAIN"];
  status -> timeout [label="timeout"];
  status -> parse [label="reply"];
  status -> bad [label="overflow/EOF/error"];
  parse -> valid;
  valid -> deliver [label="yes"];
  valid -> bad [label="no"];
  pending -> read [label="later",style=dashed,color="#64748b"];
  timeout -> read [label="next line",style=dashed,color="#64748b"];
  deliver -> read [label="next line",style=dashed,color="#64748b"];
  watch -> stop [label="shutdown/restart/IDLE",style=dashed,color="#64748b"];
}
