digraph G {
  graph [rankdir=TB,bgcolor="white",pad="0.30",nodesep="0.35",ranksep="0.48",splines=polyline,fontname="Arial",label="10 — CAKE update, bounded netlink, and readback verification",labelloc=t,fontsize=22,fontcolor="#0f172a"];
  node [fontname="Arial",fontsize=11,margin="0.14,0.09",penwidth=1.2];
  edge [fontname="Arial",fontsize=9,color="#475569",fontcolor="#334155",arrowsize=0.7,penwidth=1.1];
  start [label="decision.rate_changed",shape=oval,style="filled",fillcolor="#d9f7f1",color="#17806d"];
  shaper [label="SHAPER record\n(output_cake_changes)",shape=parallelogram,style="filled",fillcolor="#e9f7ff",color="#24749c"];
  valid [label="rate a positive multiple of 8 bit/s?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  send [label="RTM_NEWQDISC (ifindex, handle, parent)\nkind=cake, TCA_OPTIONS:\nTCA_CAKE_BASE_RATE64 = rate/8",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  ack [label="ACK within 1 s?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  fail [label="warning: bandwidth change failed\n(old, desired, reason)",shape=box,style="rounded,filled",fillcolor="#ffe3e0",color="#c2413b"];
  read [label="cake_read (one dump)\nseeded with cached ifindex/MTU",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  match [label="FOUND ∧ bandwidth == desired?",shape=diamond,style="filled",fillcolor="#fff0cc",color="#b7791f"];
  mismatch [label="warning: verification failed\n(error or readback mismatch)",shape=box,style="rounded,filled",fillcolor="#ffe3e0",color="#c2413b"];
  ok [label="observation = verified state",shape=box,style="rounded,filled,bold",fillcolor="#dcfce7",color="#15803d"];
  comp [label="control_update_compensation\nSUMMARY / DATA records",shape=box,style="rounded,filled",fillcolor="#e9f2ff",color="#3676b9"];
  start -> shaper;
  shaper -> valid;
  valid -> fail [label="no"];
  valid -> send [label="yes"];
  send -> ack;
  ack -> fail [label="no / NLMSG_ERROR"];
  ack -> read [label="yes"];
  read -> match;
  match -> mismatch [label="no"];
  match -> ok [label="yes"];
  ok -> comp;
  fail -> comp [style=dashed,color="#64748b"];
  mismatch -> comp [style=dashed,color="#64748b"];
}
