{
    // OpenWrt tasks run tools/host-test.sh and tools/sdk-build.sh.
    // The Windows dashboard task uses the system-wide .NET SDK.
    // SDK locations default to siblings of this repository (../openwrt-sdk-x86,
    // ../openwrt-sdk-filogic); set OPENWRT_SDK_X86 or OPENWRT_SDK_FILOGIC to
    // override. The host tests take the uci.h, libubox and libbpf headers from
    // the x86 SDK. The SDK build tasks ask which package variant to build:
    // all (default), base (cake-adapt), mqtt (cake-adapt-mqtt) or mqtt-ssl
    // (cake-adapt-mqtt-ssl).
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Test cake-adapt (host)",
            "type": "shell",
            "command": "sh tools/host-test.sh x86",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Generate compile_commands.json (IntelliSense)",
            "type": "shell",
            "command": "sh tools/compile-commands.sh",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "runOptions": {
                "runOn": "folderOpen"
            },
            "problemMatcher": []
        },
        {
            "label": "Build Windows dashboard (x64)",
            "type": "process",
            "command": "dotnet",
            "args": [
                "publish",
                "tools/mqtt-monitor-modern/CakeAdaptMonitor.csproj",
                "-c", "Release",
                "-r", "win-x64",
                "--self-contained", "true",
                "-p:PublishSingleFile=true",
                "-p:IncludeNativeLibrariesForSelfExtract=true",
                "-p:DebugType=None",
                "-o", "${workspaceFolder}/build/dashboard/publish"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
                    "DOTNET_NOLOGO": "1",
                    "DOTNET_GENERATE_ASPNET_CERTIFICATE": "false",
                    "NUGET_PACKAGES": "${workspaceFolder}/build/mqtt-monitor-modern/nuget"
                }
            },
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build cake-adapt (OpenWrt SDK x86)",
            "type": "shell",
            "command": "sh tools/sdk-build.sh variant=${input:variant} x86",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Build cake-adapt (OpenWrt SDK filogic)",
            "type": "shell",
            "command": "sh tools/sdk-build.sh variant=${input:variant} filogic",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$gcc"
        }
    ],
    "inputs": [
        {
            "id": "variant",
            "type": "pickString",
            "description": "Package variant to build",
            "options": [
                "all",
                "base",
                "mqtt",
                "mqtt-ssl"
            ],
            "default": "all"
        }
    ]
}
