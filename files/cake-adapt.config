
# cake-adapt configuration. Only the common options are listed here; every
# option, with its default and meaning, is documented at:
# https://github.com/huydoan94/cake-adapt/blob/main/docs/configuration.md
#
# Add another named cake_adapt section for each independent CAKE pair.
config cake_adapt 'main'
	option enabled '0'

	# Upload CAKE interface; download uses ifb4<interface>.
	option interface 'eth0'
	# For other layouts, set both to override the derived pair.
	# option ul_if 'eth0'
	# option dl_if 'ifb4eth0'

	# Rate adjustment per direction: '0' only observes, '1' adjusts CAKE.
	option adjust_dl_shaper_rate '0'
	option adjust_ul_shaper_rate '0'

	# Shaper rates in kbit/s; minimum <= base <= maximum.
	option min_dl_shaper_rate_kbps '5000'
	option base_dl_shaper_rate_kbps '20000'
	option max_dl_shaper_rate_kbps '80000'
	option min_ul_shaper_rate_kbps '5000'
	option base_ul_shaper_rate_kbps '20000'
	option max_ul_shaper_rate_kbps '35000'

	# Reflectors to ping; six are active at a time.
	list reflectors '1.1.1.1'
	list reflectors '1.0.0.1'
	list reflectors '8.8.8.8'
	list reflectors '8.8.4.4'
	list reflectors '9.9.9.9'
	list reflectors '9.9.9.10'
	list reflectors '9.9.9.11'
	list reflectors '94.140.14.15'
	list reflectors '94.140.14.140'
	list reflectors '94.140.14.141'
	list reflectors '94.140.15.15'
	list reflectors '94.140.15.16'
	list reflectors '64.6.65.6'
	list reflectors '156.154.70.1'
	list reflectors '156.154.70.2'
	list reflectors '156.154.70.3'
	list reflectors '156.154.70.4'
	list reflectors '156.154.70.5'
	list reflectors '156.154.71.1'
	list reflectors '156.154.71.2'
	list reflectors '156.154.71.3'
	list reflectors '156.154.71.4'
	list reflectors '156.154.71.5'
	list reflectors '208.67.220.2'
	list reflectors '208.67.220.123'
	list reflectors '208.67.220.220'
	list reflectors '208.67.222.2'
	list reflectors '208.67.222.123'
	list reflectors '185.228.168.9'
	list reflectors '185.228.168.10'

	# Output and logging. Logs go to /var/log, which is RAM on OpenWrt.
	# option log_to_file '1'
	# option log_file_path_override ''
	# option log_file_max_size_KB '2000'
	# option log_file_max_time_mins '10'
	# option debug '1'
	# option output_processing_stats '0'
	# option output_load_stats '0'
	# option output_reflector_stats '0'
	# option output_summary_stats '0'
	# option output_cake_changes '0'
	# option output_cpu_stats '0'
	# option output_memory_stats '0'

	# TCP measurement with eBPF (not in cake-autorate; off by default).
	# Split fping's delay between upload and download by TCP queue estimates.
	# option tcp_delay_attribution '0'
	# Hold download so its ACKs leave upload room, down to this share of the
	# upload rate, for example '0.45'; '0' disables it.
	# option ul_congest_ack_share '0'
	# Experimental, needs tcp_delay_attribution: add a TCP timestamp to clients'
	# SYNs that lack one (Windows), so their connections can be measured.
	# option tcp_timestamp_inject '0'
	# IPv4 injection switches clock or pauses after 5 stalled handshakes within
	# this many seconds; each stall delays one connection by a SYN retry.
	# option tcp_ts_stall_window_s '40'
