#!/bin/bash

set -euo pipefail
set -f

fail()
{
    printf 'cake-adapt configuration import: %s\n' "$1" >&2
    exit 1
}

if (( $# != 4 )); then
    fail "usage: $0 CONFIG_FILE UCI_DIRECTORY CAKE_ADAPT_BINARY UCI_SECTION"
fi

config_path=$1
uci_directory=$2
program=$3
section=$4
uci_command=${UCI:-/sbin/uci}
section_reference="cake-adapt.$section"

[[ $config_path == /* ]] || fail "configuration path must be absolute"
[[ $section =~ ^[A-Za-z0-9_-]+$ ]] || fail "invalid UCI section '$section'"
[[ -r $config_path ]] || fail "cannot read $config_path"
[[ -x $program ]] || fail "cannot execute $program"
[[ -x $uci_command ]] || fail "cannot execute $uci_command"
[[ -d $uci_directory/.uci ]] || fail "missing UCI staging directory"

"$BASH" -n "$config_path" ||
    fail "invalid shell syntax"

# The imported configuration is executable Bash. Run it only in this child
# process so its variables and shell settings cannot alter procd's init shell.
# shellcheck source=/dev/null
. "$config_path"

set -euo pipefail
set -f
IFS=$' \t\n'

supported_option_text=$("$program" -L) ||
    fail "could not query supported cake-adapt options"
[[ -n $supported_option_text ]] ||
    fail "cake-adapt returned no supported options"
mapfile -t supported_options <<< "$supported_option_text"
for name in "${supported_options[@]}"; do
    case $name in
    enabled|interface|config_file)
        continue
        ;;
    esac
    [[ -v $name ]] || continue

    declaration=$(declare -p "$name")
    case $declaration in
    "declare -a "*|"declare -A "*)
        fail "$name must be a scalar value"
        ;;
    esac
    value=${!name}
    if [[ $value == *$'\n'* || $value == *$'\r'* ]]; then
        fail "$name contains a line break"
    fi
    "$uci_command" -q -c "$uci_directory" -t "$uci_directory/.uci" \
        set "$section_reference.$name=$value"
done

if reflector_declaration=$(declare -p reflectors 2>/dev/null); then
    [[ $reflector_declaration == "declare -a "* ]] ||
        fail "reflectors must be an indexed array"
    (( ${#reflectors[@]} > 0 )) || fail "reflectors is empty"

    "$uci_command" -q -c "$uci_directory" -t "$uci_directory/.uci" \
        delete "$section_reference.reflectors" || true
    for reflector in "${reflectors[@]}"; do
        [[ $reflector != *$'\n'* && $reflector != *$'\r'* ]] ||
            fail "reflector contains a line break"
        "$uci_command" -q -c "$uci_directory" -t "$uci_directory/.uci" \
            add_list "$section_reference.reflectors=$reflector"
    done
fi

"$uci_command" -q -c "$uci_directory" -t "$uci_directory/.uci" \
    commit cake-adapt
