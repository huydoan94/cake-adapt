#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

PROG=${PROG:-/usr/sbin/cake-adapt}
IMPORTER=${IMPORTER:-/usr/libexec/cake-adapt/import}
RUNTIME_DIR=${RUNTIME_DIR:-/tmp/cake-adapt-config}

generate_runtime_config() {
	local section="$1"
	local config_file="$2"
	local instance_dir="$3"
	local runtime_config="$instance_dir/cake-adapt"
	local stage

	stage="$(mktemp -d "$RUNTIME_DIR/.stage.$section.XXXXXX")" || return 1
	if ! mkdir "$stage/.uci" ||
		! cp /etc/config/cake-adapt "$stage/cake-adapt"; then
		rm -rf "$stage"
		return 1
	fi
	if [ -n "$config_file" ] &&
		! "$IMPORTER" "$config_file" "$stage" "$PROG" "$section"; then
		rm -rf "$stage"
		return 1
	fi
	if ! "$PROG" -C "$stage" -S "$section" -V ||
		! mkdir -p "$instance_dir" ||
		! chmod 0700 "$instance_dir" ||
		! chmod 0600 "$stage/cake-adapt" ||
		! mv -f "$stage/cake-adapt" "$runtime_config"; then
		rm -rf "$stage"
		return 1
	fi
	rm -rf "$stage"
}

start_instance() {
	local section="$1"
	local config_file
	local enabled
	local instance_dir

	configured_instances=$((configured_instances + 1))
	config_get_bool enabled "$section" 'enabled' 0
	config_get config_file "$section" 'config_file' ''
	if [ "$enabled" -ne 1 ]; then
		logger -t cake-adapt -p daemon.notice \
			"instance '$section' disabled by configuration; not starting"
		return 0
	fi
	enabled_instances=$((enabled_instances + 1))
	case "$section" in
		''|*[!A-Za-z0-9_-]*)
			logger -t cake-adapt -p daemon.err \
				"invalid instance name '$section'; not starting"
			failed_instances=$((failed_instances + 1))
			return 0
			;;
	esac

	instance_dir="$RUNTIME_DIR/$section"
	if [ -L "$instance_dir" ] ||
		{ [ -e "$instance_dir" ] && [ ! -d "$instance_dir" ]; }; then
		logger -t cake-adapt -p daemon.err \
			"runtime configuration path $instance_dir is not a directory; not starting instance '$section'"
		failed_instances=$((failed_instances + 1))
		return 0
	fi
	if ! generate_runtime_config \
		"$section" "$config_file" "$instance_dir"; then
		logger -t cake-adapt -p daemon.err \
			"could not generate $instance_dir/cake-adapt; not starting instance '$section'"
		failed_instances=$((failed_instances + 1))
		return 0
	fi

	procd_open_instance "$section"
	procd_set_param command "$PROG" -C "$instance_dir" -S "$section"
	procd_set_param respawn
	procd_set_param term_timeout 5
	if [ -n "$config_file" ]; then
		procd_set_param file /etc/config/cake-adapt \
			"$config_file"
	else
		procd_set_param file /etc/config/cake-adapt
	fi
	procd_close_instance
	started_instances=$((started_instances + 1))
	return 0
}

start_service() {
	local configured_instances=0
	local enabled_instances=0
	local failed_instances=0
	local started_instances=0

	if ! config_load 'cake-adapt'; then
		logger -t cake-adapt -p daemon.err \
			"configuration /etc/config/cake-adapt could not be loaded; not starting"
		return 1
	fi
	if [ -L "$RUNTIME_DIR" ] || { [ -e "$RUNTIME_DIR" ] && [ ! -d "$RUNTIME_DIR" ]; }; then
		logger -t cake-adapt -p daemon.err \
			"runtime configuration path $RUNTIME_DIR is not a directory; not starting"
		return 1
	fi
	umask 077
	if ! mkdir -p "$RUNTIME_DIR" || ! chmod 0700 "$RUNTIME_DIR"; then
		logger -t cake-adapt -p daemon.err \
			"could not prepare runtime configuration directory $RUNTIME_DIR; not starting"
		return 1
	fi

	config_foreach start_instance 'cake_adapt'
	if [ "$configured_instances" -eq 0 ]; then
		logger -t cake-adapt -p daemon.err \
			"no cake_adapt instances configured; not starting"
		return 1
	fi
	if [ "$enabled_instances" -eq 0 ]; then
		logger -t cake-adapt -p daemon.notice \
			"no cake-adapt instances are enabled; not starting"
		return 0
	fi
	if [ "$started_instances" -eq 0 ] && [ "$failed_instances" -ne 0 ]; then
		return 1
	fi
	return 0
}

service_triggers() {
	procd_add_reload_trigger 'cake-adapt'
}

reload_service() {
	stop
	start
}
