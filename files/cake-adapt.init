#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

PROG=${PROG:-/usr/sbin/cake-adapt}
IMPORTER=${IMPORTER:-/usr/libexec/cake-adapt/import}
RUNTIME_DIR=${RUNTIME_DIR:-/var/run/cake-adapt}

# Each instance runs from $RUNTIME_DIR/<section>.uci, holding only its
# own section: the importer copies it from UCI with uci get and set, filling
# unset options from the instance's shell configuration. The file is built and
# validated in a private staging directory, then moved into place.
generate_runtime_config() {
	local section="$1"
	local config_file="$2"
	local runtime_config="$3"
	local stage

	stage="$(mktemp -d "$RUNTIME_DIR/.stage.$section.XXXXXX")" || return 1
	mkdir "$stage/.uci" &&
		: > "$stage/cake-adapt" &&
		"$IMPORTER" "$stage" "$PROG" "$section" ${config_file:+"$config_file"} &&
		"$PROG" -C "$stage/cake-adapt" -S "$section" -V &&
		chmod 0600 "$stage/cake-adapt" &&
		mv -f "$stage/cake-adapt" "$runtime_config"
	local status=$?
	rm -rf "$stage"
	return $status
}

# Logs why an instance does not start and counts it as failed.
skip_instance() {
	logger -t cake-adapt -p daemon.err "$1; not starting instance '$section'"
	failed_instances=$((failed_instances + 1))
}

start_instance() {
	local section="$1"
	local enabled
	local config_file
	local runtime_config="$RUNTIME_DIR/$section.uci"

	configured_instances=$((configured_instances + 1))
	config_get_bool enabled "$section" 'enabled' 0
	if [ "$enabled" -ne 1 ]; then
		logger -t cake-adapt -p daemon.notice \
			"instance '$section' disabled by configuration; not starting"
		return 0
	fi
	enabled_instances=$((enabled_instances + 1))
	config_get config_file "$section" 'config_file' ''

	case "$section" in
		''|*[!A-Za-z0-9_-]*) skip_instance "invalid instance name"; return 0 ;;
	esac
	if [ -L "$runtime_config" ] || [ -d "$runtime_config" ]; then
		skip_instance "runtime configuration path $runtime_config is not a regular file"
		return 0
	fi
	if ! generate_runtime_config "$section" "$config_file" "$runtime_config"; then
		skip_instance "could not generate $runtime_config"
		return 0
	fi

	procd_open_instance "$section"
	procd_set_param command "$PROG" -C "$runtime_config" -S "$section"
	procd_set_param respawn
	procd_set_param term_timeout 5
	procd_set_param file /etc/config/cake-adapt ${config_file:+"$config_file"}
	procd_close_instance
	started_instances=$((started_instances + 1))
}

start_service() {
	local configured_instances=0
	local enabled_instances=0
	local failed_instances=0
	local started_instances=0

	if ! config_load 'cake-adapt'; then
		logger -t cake-adapt -p daemon.err \
			"configuration /etc/config/cake-adapt could not be loaded; not starting"
		return 1
	fi
	# mkdir -p below fails on any other non-directory.
	if [ -L "$RUNTIME_DIR" ]; then
		logger -t cake-adapt -p daemon.err \
			"runtime configuration path $RUNTIME_DIR is a symbolic link; not starting"
		return 1
	fi
	umask 077
	if ! mkdir -p "$RUNTIME_DIR" || ! chmod 0700 "$RUNTIME_DIR"; then
		logger -t cake-adapt -p daemon.err \
			"could not prepare runtime configuration directory $RUNTIME_DIR; not starting"
		return 1
	fi

	config_foreach start_instance 'cake_adapt'
	if [ "$configured_instances" -eq 0 ]; then
		logger -t cake-adapt -p daemon.err "no cake_adapt instances configured; not starting"
		return 1
	fi
	if [ "$enabled_instances" -eq 0 ]; then
		logger -t cake-adapt -p daemon.notice "no cake-adapt instances are enabled; not starting"
		return 0
	fi
	# Fails only when nothing could start.
	[ "$started_instances" -ne 0 ] || [ "$failed_instances" -eq 0 ]
}

service_triggers() {
	procd_add_reload_trigger 'cake-adapt'
}

reload_service() {
	stop
	start
}
