config sqm_mon 'main'
	option enabled '0'
	# Set this to the WAN network device before enabling the service.
	# option interface 'eth0'
	# Optional IFB device carrying shaped ingress/download traffic.
	# option ingress_interface 'ifb4eth0'
	# Optional IPv4 address used for read-only ICMP latency observation.
	# option latency_target '1.1.1.1'
	# CAKE adjustment is disabled unless explicitly enabled per direction.
	option adjust_dl_shaper_rate '0'
	option adjust_ul_shaper_rate '0'
	# Set all three rates before enabling the corresponding direction.
	# option min_dl_shaper_rate_kbps '5000'
	# option base_dl_shaper_rate_kbps '20000'
	# option max_dl_shaper_rate_kbps '80000'
	# option min_ul_shaper_rate_kbps '5000'
	# option base_ul_shaper_rate_kbps '20000'
	# option max_ul_shaper_rate_kbps '35000'
	# Write debug and operational logs to RAM instead of syslog.
	option log_file '/tmp/sqm-mon-test.log'
	option log_level 'debug'
