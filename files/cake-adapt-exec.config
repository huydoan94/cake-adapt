# cake-adapt options that make root run a program or a file, choose its
# arguments, or choose where it writes. They live here, apart from
# /etc/config/cake-adapt, because the LuCI app can change that file but not
# this one; only root may set these.
# Each section is named after its cake_adapt instance in
# /etc/config/cake-adapt, where the same options are refused. procd does not
# watch this file: after a change, run /etc/init.d/cake-adapt reload.
#
# config_file: a cake-autorate style Bash configuration whose values fill the
#   options the instance's UCI section leaves unset (needs bash installed).
# ping_prefix_string: command words placed before fping or irtt, such as a
#   wrapper that runs it in another routing context (not used by native).
# ping_extra_args: extra arguments for fping or irtt (not used by native).
# log_file_path_override: the log directory instead of /var/log.
#
# config cake_adapt_exec 'main'
#	option config_file '/etc/cake-adapt/config.main.sh'
#	option ping_prefix_string 'mwan3 use wan'
#	option ping_extra_args '-S 192.0.2.1'
#	option log_file_path_override '/tmp/cake-adapt'
